{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun"
    ],
    "paths": {
      "@kitchen/sounds": [
        "./packages/sounds/src/index.ts"
      ],
      "@shared/*": [
        "./apps/web/src/shared/*"
      ],
      "@shell/*": [
        "./apps/web/src/shell/*"
      ],
      "@timer/*": [
        "./apps/web/src/tools/timer/*"
      ],
      "@scaler/*": [
        "./apps/web/src/tools/scaler/*"
      ],
      "@recipes/*": [
        "./apps/web/src/tools/recipes/*"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "packages",
    "apps"
  ],
  "exclude": [
    "**/dist"
  ]
}
