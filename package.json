{
  "name": "thyme-after-thyme",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint apps packages",
    "check": "bun run recipes:bundle && bun run recipes:check && bun run lint && bun run typecheck && bun test",
    "web:dev": "bun run recipes:bundle && bun ./apps/web/index.html",
    "web:build": "bun run recipes:bundle && bun build ./apps/web/index.html --outdir ./apps/web/dist --minify --public-path ${PUBLIC_PATH:-/} && bun scripts/postbuild.ts",
    "sounds:test": "bun test packages/sounds",
    "web:test": "bun test apps/web",
    "recipes:bundle": "bun scripts/recipe-data.ts",
    "recipes:check": "bun scripts/check-translations.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.15.0",
    "typescript": "^5",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
