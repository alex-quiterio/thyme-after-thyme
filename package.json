{
  "name": "thyme-after-thyme",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "timer:dev": "bun ./apps/timer/index.html",
    "timer:build": "bun build ./apps/timer/index.html --outdir ./apps/timer/dist --minify --public-path ${PUBLIC_PATH:-/}",
    "sounds:test": "bun test packages/sounds",
    "timer:test": "bun test apps/timer",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint apps/timer packages",
    "check": "bun run lint && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.15.0",
    "typescript": "^5",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
